# ---------------------------------------------------------------------------
# Bricky AI — website configuration
# Copy this file to `.env.local` and adjust as needed.
# All variables are optional; the defaults in `src/lib/config.ts` are used
# when these are not set.
# ---------------------------------------------------------------------------

# URL/path of the Windows installer.
# By default the site serves `public/downloads/BrickyAI-Setup.exe`.
# To go live, either:
#   1. drop BrickyAI-Setup.exe into `public/downloads/` (no changes needed), or
#   2. set this to your hosted installer URL/path.
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=/downloads/BrickyAI-Setup.exe

# Optional download URL/path for the Roblox Studio plugin (.rbxmx).
# By default the site serves `public/downloads/BrickyAI.rbxmx`.
NEXT_PUBLIC_PLUGIN_DOWNLOAD_URL=/downloads/BrickyAI.rbxmx

# Optional deep-link for users who already have Bricky AI installed.
# Leave empty to hide the "Launch the app" shortcut.
NEXT_PUBLIC_LAUNCH_APP_URL=

# Canonical production origin used to build post-auth redirect links.
# IMPORTANT: set this to the DEPLOYED domain in Vercel (Production
# environment). Leave unset on local/preview so the current origin is used.
NEXT_PUBLIC_SITE_URL=https://bricky-ai.vercel.app

# ---------------------------------------------------------------------------
# Bricky AI backend (WordPress) — REQUIRED for authentication
# ---------------------------------------------------------------------------
# All authentication, account, credits and subscription data live in the
# WordPress "Bricky AI API" plugin (`wp-json/bricky/v1`, plus the JWT plugin at
# `wp-json/jwt-auth/v1`). This site talks to WordPress only from server-side
# BFF routes; the browser never receives a JWT (it is kept in an HttpOnly
# `bricky_session` cookie set by this app).
#
# Local development (XAMPP):  http://localhost/wordpress
# Production:                 https://api.brickyai.com  (or your WP host)
#
# Sign-in is DISABLED automatically when this is unset: pages render, download
# links work as plain links, and users are not asked to sign in.
NEXT_PUBLIC_BRICKY_API_URL=http://localhost/wordpress

# ---------------------------------------------------------------------------
# WordPress side note (not read by this app)
# ---------------------------------------------------------------------------
# The WordPress plugin redirects Google sign-in back to this site's
# `/auth/google/callback` using its own `BRICKY_FRONTEND_URL` constant
# (wp-config.php). Make sure that constant points at the deployed frontend URL
# in production (e.g. https://brickyai.com) so the callback lands here.
