# ---------------------------------------------------------------------------
# Bricky AI — website configuration
# Copy this file to `.env.local` and adjust as needed.
# All variables are optional; the defaults in `src/lib/config.ts` are used
# when these are not set.
# ---------------------------------------------------------------------------

# URL/path of the Windows installer.
# By default the site serves `public/downloads/BrickyAI-Setup.exe`.
# To go live, either:
#   1. drop BrickyAI-Setup.exe into `public/downloads/` (no changes needed), or
#   2. set this to your hosted installer URL/path.
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=/downloads/BrickyAI-Setup.exe

# Optional deep-link for users who already have Bricky AI installed.
# Leave empty to hide the "Launch the app" shortcut.
NEXT_PUBLIC_LAUNCH_APP_URL=

# Canonical production origin used for OAuth redirects and the desktop-app
# authentication handshake (/auth/desktop).
# IMPORTANT: set this to the DEPLOYED domain in Vercel (Production
# environment). Current production host is https://bricky-ai.vercel.app.
# Leave unset on local/preview so the current origin is used (allows localhost
# for local development only — production redirects NEVER use localhost).
NEXT_PUBLIC_SITE_URL=https://bricky-ai.vercel.app

# ---------------------------------------------------------------------------
# Authentication (optional)
# ---------------------------------------------------------------------------
# Bricky AI signs users in with Supabase Auth (email + password, and
# "Continue with Google" via Google OAuth).
#
# Auth is DISABLED automatically when these are not set: pages render, the
# download links work as plain links, and users are not asked to sign in.
# Set them to activate sign-in and download protection.
#
# 1. Create a project at https://supabase.com.
# 2. Copy the "Project URL" and the public "Publishable" key (Settings > API).
#    The publishable/anonymized key is safe to expose to the browser and is
#    always used from browser-side code (Auth, profile reads via RLS).
# 3. Enable the Google provider (Authentication > Providers > Google) and
#    follow `docs/GOOGLE_OAUTH_SETUP.md` for the Google Cloud Console config.
NEXT_PUBLIC_SUPABASE_URL=https://gxjbtqfzblxvmbbvrmgo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — NEVER prefix with NEXT_PUBLIC_ and never expose to the browser.
# Used by the account deletion endpoint (src/app/api/account/delete/route.ts)
# and the desktop-app sign-in routes (/api/auth/desktop/*) via the server-only
# client (src/lib/supabase/server.ts).
# Create a new "Secret" Service Role key in Settings > API and add it to
# Vercel as a regular (non-prefixed) Environment Variable:
#   Vercel → Project → Settings → Environment Variables → SUPABASE_SECRET_KEY
# The desktop flow also needs the `desktop_auth_sessions` table in Supabase:
#   supabase/migrations/20260916000000_desktop_auth_sessions.sql (run in the SQL Editor).
SUPABASE_SECRET_KEY=
